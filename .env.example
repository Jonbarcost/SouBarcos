# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com os dados de verdade) para o GitHub.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sua_chave_do_supabase_aqui

# Senha que você mesmo escolhe, usada para acessar o painel de administração
ADMIN_PASSWORD=escolha_uma_senha_forte

PORT=3000
