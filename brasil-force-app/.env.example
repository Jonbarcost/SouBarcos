SITE_URL=http://localhost:3000
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false

AUTH_REGISTRATION_ENABLED=false

# IA: autenticação somente no servidor. Preferir OIDC válido no runtime Vercel.
