# Logística: credenciais privadas. Não usar NEXT_PUBLIC_ nestas variáveis.
SHIPPING_ENABLED=false
SHIPPING_PRODUCTION_ENABLED=false
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
SHIPPING_TECHNICAL_EMAIL=
