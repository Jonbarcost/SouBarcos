NEXT_PUBLIC_SUPABASE_URL=https://rrymtjzsekmjplyuoqef.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false

AUTH_REGISTRATION_ENABLED=false

# IA: autenticação somente no servidor. Preferir OIDC válido no runtime Vercel.
BF_AI_ENABLED=false
BF_AI_MODEL=
AI_GATEWAY_API_KEY=
# Não copie VERCEL_OIDC_TOKEN para arquivos; o runtime deve fornecê-lo.

# Logística: credenciais privadas. Não usar NEXT_PUBLIC_ nestas variáveis.
SHIPPING_ENABLED=false
SHIPPING_PRODUCTION_ENABLED=false
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
SHIPPING_TECHNICAL_EMAIL=
# IDs dos serviços homologados, separados por vírgula. Vazio bloqueia cotação.
MELHOR_ENVIO_SERVICE_IDS=

# Zoho Mail: private server-only configuration; activation defaults to blocked.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Independent CSPRNG-generated 32-byte keys, each encoded as 64 hexadecimal characters.
ZOHO_OAUTH_STATE_SECRET=
ZOHO_TOKEN_ENCRYPTION_KEY=
ZOHO_REGION=
ZOHO_REDIRECT_URI=
ZOHO_MAILBOX_ADDRESS=contato@brasilforce.com.br
ZOHO_CREDENTIALS_REVIEWED=false
ZOHO_OAUTH_ENABLED=false
ZOHO_MAIL_READ_ENABLED=false
ZOHO_MAIL_SEND_ENABLED=false

# Captcha (Cloudflare Turnstile). Site key é pública; a secret também vai no painel do Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# E-mail transacional do site (Zoho Mail SMTP, senha de aplicativo). Ver docs/EMAIL-E-CAPTCHA.md.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=contato@brasilforce.com.br
SMTP_PASSWORD=
MAIL_FROM=Brasil Force <contato@brasilforce.com.br>
MAIL_TEAM_TO=contato@brasilforce.com.br
