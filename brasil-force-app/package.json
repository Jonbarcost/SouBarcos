{
  "name": "brasil-force",
  "version": "0.1.0",
  "description": "Brasil Force — fundação do marketplace",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:http": "node scripts/http-check.mjs",
    "env:check": "node scripts/environment-check.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:local:start": "node scripts/first-seller/manage.mjs start",
    "test:local:stop": "node scripts/first-seller/manage.mjs stop",
    "test:integration": "node scripts/first-seller/run.mjs integration",
    "test:e2e": "node scripts/first-seller/run.mjs e2e",
    "test:first-seller": "node scripts/first-seller/run.mjs all",
    "test:local:cleanup": "node scripts/first-seller/manage.mjs cleanup"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true
}
